# ============================================================
#  Amplex – Variáveis de Ambiente (produção)
#  Copie para .env e preencha os valores marcados como TROQUE.
#
#  Arquitetura de produção:
#    VPS 1 → Hub + Nexus + Amplex + Infra (postgres, redis, minio)
#    URL: amplex.igaralead.com.br
#
#  IGARALEAD_DOMAIN deriva automaticamente as URLs do Hub,
#  Nexus, Entity e do próprio Amplex.
#
#  🔧 DEV: linhas marcadas com "# [DEV]" mostram o valor para
#     desenvolvimento local. Descomente/substitua conforme necessário.
# ============================================================

# ── Ecossistema ──────────────────────────────────────────────
IGARALEAD_DOMAIN=igaralead.com.br
# [DEV] Comente a linha acima para usar fallback localhost.

# Domínios personalizados (opcional — sobrescreve o padrão derivado)
# HUB_DOMAIN=painel.clientecorp.com.br
# NEXUS_DOMAIN=chat.clientecorp.com.br
# ENTITY_DOMAIN=dados.clientecorp.com.br
# AMPLEX_DOMAIN=crm.clientecorp.com.br

# ── Deploy ───────────────────────────────────────────────────
GHCR_OWNER=igaralead

# ── Segredos ─────────────────────────────────────────────────
AMPLEX_SECRET_KEY=TROQUE-chave-aleatoria-forte
AMPLEX_HUB_API_KEY=TROQUE-service-api-key-do-hub

# ── Banco de Dados ───────────────────────────────────────────
# Produção: serviço "postgres" da stack Infra via rede igaralead_public
AMPLEX_DATABASE_URL=postgresql://postgres:TROQUE-senha-forte@postgres:5432/amplex
# AMPLEX_DB_SSLMODE=disable
# [DEV] AMPLEX_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/amplex

# ── S3 / MinIO ──────────────────────────────────────────────
# Produção: MinIO da stack Infra via rede igaralead_public
AMPLEX_S3_ENDPOINT=http://minio:9000
AMPLEX_S3_ACCESS_KEY=TROQUE-access-key
AMPLEX_S3_SECRET_KEY=TROQUE-secret-key
AMPLEX_S3_BUCKET=amplex
# [DEV] AMPLEX_S3_ENDPOINT=http://localhost:9000

# ── Overrides (normalmente não precisa mexer) ────────────────
# As URLs abaixo são derivadas automaticamente de IGARALEAD_DOMAIN.
# Descomente apenas se precisar sobrescrever.
# AMPLEX_FRONTEND_URL=https://amplex.igaralead.com.br
# AMPLEX_HUB_URL=https://hub.igaralead.com.br
# AMPLEX_COOKIE_DOMAIN=.igaralead.com.br

# ── Frontend (Vite) ─────────────────────────────────────────
VITE_HUB_URL=https://hub.igaralead.com.br
# [DEV] VITE_HUB_URL=http://localhost:8001
# VITE_BRAND_NAME=IgaraLead
# VITE_BRAND_URL=https://igaralead.com.br
# VITE_HUB_NAME=IgaraHub
# VITE_NEXUS_NAME=Nexus
# VITE_ENTITY_NAME=Entity
# VITE_AMPLEX_NAME=Amplex
