# ============================================================
#  Amplex — Variáveis de ambiente
# ============================================================
#  Copie para .env e selecione o ambiente atual.
#
#  O docker-compose.yml é autocontido: app, PostgreSQL, Redis e MinIO.
#  ENVIRONMENT controla comportamento da aplicação:
#    production  -> sem seed fictício
#    development -> roda seed admin/org idempotente
#
#  Segurança de dados em ambientes com clientes:
#    - nunca rode `docker compose down -v`
#    - faça backup de Postgres e MinIO antes de atualizar produção
#    - preserve os nomes de volume abaixo ao mover/editar compose
#    - revise migrations antes de aplicar qualquer deploy
# ============================================================

# ── Seleção de ambiente ──────────────────────────────────────
ENVIRONMENT=production

# ── Compose / Imagem ─────────────────────────────────────────
AMPLEX_IMAGE=ghcr.io/igaralead/amplex:latest
AMPLEX_PULL_POLICY=always
AMPLEX_CONTAINER_NAME=amplex
AMPLEX_RESTART_POLICY=always
AMPLEX_PORT_BIND=127.0.0.1:8002:8000
AMPLEX_NETWORK_NAME=amplex_network
AMPLEX_NETWORK_EXTERNAL=false

AMPLEX_POSTGRES_CONTAINER=amplex-postgres
AMPLEX_REDIS_CONTAINER=amplex-redis
AMPLEX_MINIO_CONTAINER=amplex-minio
AMPLEX_MINIO_INIT_CONTAINER=amplex-minio-init
AMPLEX_FRONTEND_CONTAINER=amplex-frontend

POSTGRES_DATA_VOLUME=amplex_postgres_data
REDIS_DATA_VOLUME=amplex_redis_data
MINIO_DATA_VOLUME=amplex_minio_data
AMPLEX_WEB_NODE_MODULES_VOLUME=amplex_web_node_modules

# Para desenvolvimento local, use:
# ENVIRONMENT=development
# COMPOSE_PROFILES=dev
# AMPLEX_IMAGE=amplex:local
# AMPLEX_PULL_POLICY=build
# AMPLEX_CONTAINER_NAME=amplex-dev
# AMPLEX_POSTGRES_CONTAINER=amplex-dev-postgres
# AMPLEX_REDIS_CONTAINER=amplex-dev-redis
# AMPLEX_MINIO_CONTAINER=amplex-dev-minio
# AMPLEX_MINIO_INIT_CONTAINER=amplex-dev-minio-init
# AMPLEX_FRONTEND_CONTAINER=amplex-dev-frontend
# AMPLEX_RESTART_POLICY=unless-stopped
# AMPLEX_PORT_BIND=8002:8000
# AMPLEX_NETWORK_NAME=amplex_dev
# AMPLEX_COMMAND=python manage.py runserver 0.0.0.0:8000

# ── Plataforma ───────────────────────────────────────────────
IGARALEAD_DOMAIN=igaralead.com.br
# Em development, use IGARALEAD_DOMAIN=localhost.

# ── Segredos ─────────────────────────────────────────────────
SECRET_KEY_BASE=TROQUE-chave-aleatoria-64-chars

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=TROQUE-senha-forte
POSTGRES_DATABASE=amplex
# POSTGRES_SSLMODE=disable
# POSTGRES_SSLMODE=require

# Em development, use:
# POSTGRES_HOST=postgres
# POSTGRES_USERNAME=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DATABASE=amplex

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:redispass@redis:6379/0
REDIS_PASSWORD=redispass

# Em development, use:
# REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=

# ── Storage / MinIO ──────────────────────────────────────────
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY_ID=TROQUE-mesmo-valor-de-MINIO_ROOT_USER
STORAGE_SECRET_ACCESS_KEY=TROQUE-mesmo-valor-de-MINIO_ROOT_PASSWORD
STORAGE_BUCKET_NAME=amplex
STORAGE_REGION=us-east-1

# Em development, use:
# STORAGE_ACCESS_KEY_ID=minioadmin
# STORAGE_SECRET_ACCESS_KEY=minioadmin

# ── Frontend / cookies ───────────────────────────────────────
FRONTEND_URL=https://amplex.seudominio.com.br
# COOKIE_DOMAIN=.seudominio.com.br
# AMPLEX_TRUSTED_HOSTS=amplex.seudominio.com.br
# AMPLEX_CORS_ORIGINS=https://amplex.seudominio.com.br

# ── Seed inicial (apenas development) ────────────────────────
AMPLEX_ADMIN_EMAIL=TROQUE-admin-email
AMPLEX_ADMIN_PASSWORD=TROQUE-admin-password
AMPLEX_ADMIN_NAME=TROQUE-admin-name
AMPLEX_DEFAULT_ORG_NAME=TROQUE-org-name
AMPLEX_DEFAULT_ORG_SLUG=TROQUE-org-slug
# 0 = ilimitado
AMPLEX_DEFAULT_ORG_SEAT_LIMIT=0
