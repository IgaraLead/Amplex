# ============================================================
#  Amplex – Variáveis de Ambiente
#  Copie para stack.env (Portainer) ou .env (dev) e ajuste.
#
#  Arquitetura de produção:
#    VPS 1 → Hub + Nexus + Amplex + Infra (postgres, redis, minio)
#    URL: amplex.igaralead.com.br (porta interna 8002)
#
#  IGARALEAD_DOMAIN deriva automaticamente as URLs do Hub,
#  Nexus, Entity e do próprio Amplex.
# ============================================================

# ── Ecossistema ──────────────────────────────────────────────
IGARALEAD_DOMAIN=igaralead.com.br
# [DEV] Comente a linha acima para usar fallback localhost.

# Domínios personalizados (opcional — sobrescreve o padrão derivado)
# HUB_DOMAIN=painel.clientecorp.com.br
# NEXUS_DOMAIN=chat.clientecorp.com.br
# ENTITY_DOMAIN=dados.clientecorp.com.br
# AMPLEX_DOMAIN=crm.clientecorp.com.br

# ── Segredos ─────────────────────────────────────────────────
SECRET_KEY_BASE=TROQUE-chave-aleatoria-64-chars

HUB_API_KEY=TROQUE-api-key-ecossistema

# ── Banco de Dados (postgres da stack Infra) ─────────────────
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=TROQUE-senha-forte
# POSTGRES_USERNAME=postgres     # default
# POSTGRES_DATABASE=igaralead    # default (BD unificado)
# POSTGRES_PORT=5432             # default
# POSTGRES_SSLMODE=require       # default em produção

# ── Redis (redis da stack Infra) ─────────────────────────────
REDIS_PASSWORD=TROQUE-senha-forte
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0  # auto-derivado

# ── Storage / MinIO ──────────────────────────────────────────
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY_ID=TROQUE-access-key
STORAGE_SECRET_ACCESS_KEY=TROQUE-secret-key
# STORAGE_BUCKET_NAME=amplex     # default
# STORAGE_REGION=us-east-1       # default

# ── URLs (opcional se IGARALEAD_DOMAIN estiver definido) ─────
# FRONTEND_URL=https://amplex.igaralead.com.br
# HUB_URL=https://hub.igaralead.com.br
# NEXUS_URL=https://nexus.igaralead.com.br
# ENTITY_URL=https://cnpj.igaralead.com.br
# COOKIE_DOMAIN=.igaralead.com.br
# AMPLEX_TRUSTED_HOSTS=amplex.igaralead.com.br,localhost
# AMPLEX_CORS_ORIGINS=https://amplex.igaralead.com.br

# ── Frontend (Vite) ─────────────────────────────────────────
# (login is handled by Amplex backend — no frontend Hub vars needed)
