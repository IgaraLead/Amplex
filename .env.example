# ============================================================
#  Amplex — Variáveis de ambiente (MVP standalone)
#  Copie para stack.env / .env e ajuste.
# ============================================================

SECRET_KEY_BASE=TROQUE-chave-aleatoria-64-chars

# ── Seed inicial (entrypoint: migrate + amplex_bootstrap) ──
AMPLEX_ADMIN_EMAIL=admin@dev.local
AMPLEX_ADMIN_PASSWORD=admin123
AMPLEX_ADMIN_NAME=Admin
AMPLEX_DEFAULT_ORG_NAME=Dev Org
AMPLEX_DEFAULT_ORG_SLUG=dev
# 0 = ilimitado
# AMPLEX_DEFAULT_ORG_SEAT_LIMIT=0

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=TROQUE-senha-forte
# POSTGRES_USERNAME=postgres
# POSTGRES_DATABASE=amplex
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=require

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://infra-redis-1:6379
REDIS_PASSWORD=redispass

# ── Frontend / cookies ───────────────────────────────────────
ENVIRONMENT=production
FRONTEND_URL=https://amplex.seudominio.com.br
# COOKIE_DOMAIN=.seudominio.com.br
# AMPLEX_TRUSTED_HOSTS=amplex.seudominio.com.br
# AMPLEX_CORS_ORIGINS=https://amplex.seudominio.com.br

# ── Storage / MinIO ──────────────────────────────────────────
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY_ID=TROQUE-access-key
STORAGE_SECRET_ACCESS_KEY=TROQUE-secret-key
# STORAGE_BUCKET_NAME=amplex
